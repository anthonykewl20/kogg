# Copy to .env.local or run `yarn generate:secrets`.
KOGG_AUTH_TOKEN=
KOGG_MASTER_KEY=
KOGG_REGISTRY_URL=http://127.0.0.1:3100
KOGG_MARKETPLACE_PUBLIC_KEY_PATH=.kogg/dev/marketplace-public.pem
KOGG_RUNTIME=browser
KOGG_STATE_DIR=.kogg/state

# Production browser deployments must set this to the public HTTPS origin.
KOGG_PUBLIC_ORIGIN=
