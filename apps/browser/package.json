{
  "name": "@kogg/browser-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@kogg/agents": "0.1.0",
    "@kogg/claude-adapter": "0.1.0",
    "@kogg/codex-adapter": "0.1.0",
    "@kogg/contracts": "0.1.0",
    "@kogg/core": "0.1.0",
    "@kogg/kernel": "0.1.0",
    "@kogg/interaction-modes": "0.1.0",
    "@kogg/marketplace": "0.1.0",
    "@kogg/operations": "0.1.0",
    "@kogg/projects": "0.1.0",
    "@kogg/execution": "0.1.0",
    "@kogg/providers": "0.1.0",
    "@kogg/tasks": "0.1.0",
    "@kogg/verdict-merge": "0.1.0",
    "@kogg/workflow": "0.1.0",
    "@theia/core": "1.74.1",
    "@theia/debug": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/scm-extra": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/task": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1",
    "cross-env": "10.1.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  },
  "scripts": {
    "bundle": "yarn rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "cross-env KOGG_RUNTIME=browser KOGG_ROOT=../.. theia start --plugins=local-dir:../../plugins --hostname 127.0.0.1 --port 3000",
    "watch": "yarn rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Kogg",
        "reloadOnReconnect": true,
        "preferences": {
          "telemetry.telemetryLevel": "off"
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".kogg",
        "configureProxyFromPreferences": true,
        "frontendConnectionTimeout": 30000
      }
    }
  }
}
